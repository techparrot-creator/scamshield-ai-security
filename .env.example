# Required: Google AI Studio / Gemini
GOOGLE_API_KEY=

# Models
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MEDIA_MODEL=gemini-3.1-flash-lite

# Advanced RAG
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_EMBEDDING_DEVICE=cpu
RAG_BACKEND=advanced
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_SCORE_THRESHOLD=0.28
RAG_EXPAND_THRESHOLD=0.43
RAG_MMR_LAMBDA=0.72

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=scamshield-ai-hackathon

# Gradio
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
